{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spark-electric",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "run_worker_first": ["/_ipx/*"]
  },
  "observability": {
    "enabled": true
  }
}
